{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_analytics_list }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">

    <div class="row">
      <div class="col-lg-6">
        <div class="card mb-3">
          <div class="card-header"><i class="fa-solid fa-chart-pie"></i> Events by Type</div>
          <div class="card-body">
            <canvas id="eventsByTypeChart"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card mb-3">
          <div class="card-header"><i class="fa-solid fa-chart-line"></i> Daily Activity (Last 7 Days)</div>
          <div class="card-body">
            <canvas id="dailyActivityChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-chart-bar"></i> {{ text_analytics_list }}</div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-start">{{ column_event_type }}</td>
                <td class="text-start">{{ column_customer }}</td>
                <td class="text-start">{{ column_event_data }}</td>
                <td class="text-start">{{ column_date_added }}</td>
              </tr>
            </thead>
            <tbody>
              {% if events %}
                {% for event in events %}
                  <tr>
                    <td class="text-start"><code>{{ event.event_type }}</code></td>
                    <td class="text-start"><a href="{{ customer_link ~ '&customer_id=' ~ event.customer_id }}">{{ event.customer_id }}</a></td>
                    <td class="text-start"><pre>{{ event.event_data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                    <td class="text-start">{{ event.date_added }}</td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="text-center" colspan="4">{{ text_no_results }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="text/javascript"><!--
// Chart for Events by Type
const eventsByTypeCtx = document.getElementById('eventsByTypeChart');
new Chart(eventsByTypeCtx, {
    type: 'pie',
    data: {
        labels: {{ chart_events_by_type_labels|html_entity_decode('ENT_QUOTES') }},
        datasets: [{
            label: '# of Events',
            data: {{ chart_events_by_type_data|html_entity_decode('ENT_QUOTES') }},
            backgroundColor: [
                'rgba(255, 99, 132, 0.7)',
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 206, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)'
            ],
            borderColor: [
                'rgba(255, 99, 132, 1)',
                'rgba(54, 162, 235, 1)',
                'rgba(255, 206, 86, 1)',
                'rgba(75, 192, 192, 1)',
                'rgba(153, 102, 255, 1)',
                'rgba(255, 159, 64, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'top',
            }
        }
    }
});

// Chart for Daily Activity
const dailyActivityCtx = document.getElementById('dailyActivityChart');
new Chart(dailyActivityCtx, {
    type: 'line',
    data: {
        labels: {{ chart_daily_activity_labels|html_entity_decode('ENT_QUOTES') }},
        datasets: [{
            label: 'Events per Day',
            data: {{ chart_daily_activity_data|html_entity_decode('ENT_QUOTES') }},
            fill: false,
            borderColor: 'rgb(75, 192, 192)',
            tension: 0.1
        }]
    },
    options: {
        responsive: true,
        scales: {
            y: {
                beginAtZero: true
            }
        }
    }
});
//--></script>
{{ footer }}