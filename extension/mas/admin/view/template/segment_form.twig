{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-segment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_segment_form }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-segment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="segment_id" value="{{ segment_id }}"/>

          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-description" class="col-sm-2 col-form-label">{{ entry_description }}</label>
            <div class="col-sm-10">
              <textarea name="description" rows="5" placeholder="{{ entry_description }}" id="input-description" class="form-control">{{ description }}</textarea>
            </div>
          </div>

          <fieldset>
            <legend>{{ text_rules }}</legend>
            <table id="rules" class="table table-striped table-bordered">
              <thead>
                <tr>
                  <td class="text-start required">{{ entry_rule_type }}</td>
                  <td class="text-start required">{{ entry_operator }}</td>
                  <td class="text-start required">{{ entry_value }}</td>
                  <td></td>
                </tr>
              </thead>
              <tbody>
                {% set rule_row = 0 %}
                {% for rule in rules %}
                  <tr id="rule-row{{ rule_row }}">
                    <td class="text-start">
                      <select name="rules[{{ rule_row }}][type]" class="form-select rule-type" data-row="{{ rule_row }}">
                        {% for key, def in rule_definitions %}
                          <option value="{{ key }}" {% if key == rule.type %}selected{% endif %}>{{ def.name }}</option>
                        {% endfor %}
                      </select>
                    </td>
                    <td class="text-start rule-operator-cell">
                        {# Operator dropdown will be populated by JS #}
                    </td>
                    <td class="text-start rule-value-cell">
                        {# Value input will be populated by JS #}
                    </td>
                    <td class="text-end"><button type="button" onclick="$('#rule-row{{ rule_row }}').remove();" data-bs-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>
                  </tr>
                  {% set rule_row = rule_row + 1 %}
                {% endfor %}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3"></td>
                  <td class="text-end"><button type="button" onclick="addRule();" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i></button></td>
                </tr>
              </tfoot>
            </table>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var rule_row = {{ rule_row }};
var rule_definitions = {{ rule_definitions|json_encode|html_entity_decode('ENT_QUOTES') }};
var source_data = {
    'customer_groups': {{ customer_groups|json_encode|html_entity_decode('ENT_QUOTES') }},
    'countries': {{ countries|json_encode|html_entity_decode('ENT_QUOTES') }}
};
var existing_rules = {{ rules|json_encode|html_entity_decode('ENT_QUOTES') }};

function addRule() {
    var html = '<tr id="rule-row' + rule_row + '">';
    html += '  <td class="text-start">';
    html += '    <select name="rules[' + rule_row + '][type]" class="form-select rule-type" data-row="' + rule_row + '">';
    for (var key in rule_definitions) {
        html += '<option value="' + key + '">' + rule_definitions[key]['name'] + '</option>';
    }
    html += '    </select>';
    html += '  </td>';
    html += '  <td class="text-start rule-operator-cell"></td>';
    html += '  <td class="text-start rule-value-cell"></td>';
    html += '  <td class="text-end"><button type="button" onclick="$(\'#rule-row' + rule_row + '\').remove();" data-bs-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>';
    html += '</tr>';

    $('#rules tbody').append(html);
    $('#rule-row' + rule_row + ' .rule-type').trigger('change');
    rule_row++;
}

function updateRuleRow(row_id, rule_type, selected_operator = '', selected_value = '') {
    var definition = rule_definitions[rule_type];
    if (!definition) return;

    // Update operators
    var operator_html = '<select name="rules[' + row_id + '][operator]" class="form-select">';
    for (var i = 0; i < definition.operators.length; i++) {
        var operator = definition.operators[i];
        var selected = (operator == selected_operator) ? ' selected' : '';
        operator_html += '<option value="' + operator + '"' + selected + '>' + operator + '</option>';
    }
    operator_html += '</select>';
    $('#rule-row' + row_id + ' .rule-operator-cell').html(operator_html);

    // Update value input
    var value_html = '';
    if (definition.type === 'select') {
        value_html += '<select name="rules[' + row_id + '][value]" class="form-select">';
        var source = source_data[definition.source];
        var value_key = (definition.source === 'countries') ? 'country_id' : 'customer_group_id';
        for (var i = 0; i < source.length; i++) {
            var selected = (source[i][value_key] == selected_value) ? ' selected' : '';
            value_html += '<option value="' + source[i][value_key] + '"' + selected + '>' + source[i]['name'] + '</option>';
        }
        value_html += '</select>';
    } else {
        var placeholder = (definition.type === 'date') ? 'YYYY-MM-DD' : '';
        value_html += '<input type="text" name="rules[' + row_id + '][value]" value="' + selected_value + '" class="form-control" placeholder="' + placeholder + '"/>';
    }
    $('#rule-row' + row_id + ' .rule-value-cell').html(value_html);
}

$(document).on('change', '.rule-type', function() {
    var row_id = $(this).data('row');
    var rule_type = $(this).val();
    updateRuleRow(row_id, rule_type);
});

// Initialize existing rows on page load
$(document).ready(function() {
    for (var i = 0; i < rule_row; i++) {
        var rule_type = $('#rule-row' + i + ' .rule-type').val();
        var selected_operator = existing_rules[i] ? existing_rules[i].operator : '';
        var selected_value = existing_rules[i] ? existing_rules[i].value : '';
        updateRuleRow(i, rule_type, selected_operator, selected_value);
    }
});
//--></script>
{{ footer }}