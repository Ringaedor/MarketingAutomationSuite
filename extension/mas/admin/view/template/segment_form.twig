{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-segment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_segment_form }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-segment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="segment_id" value="{{ segment_id }}"/>

          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-description" class="col-sm-2 col-form-label">{{ entry_description }}</label>
            <div class="col-sm-10">
              <textarea name="description" rows="5" placeholder="{{ entry_description }}" id="input-description" class="form-control">{{ description }}</textarea>
            </div>
          </div>

          <fieldset>
            <legend>{{ text_rules }}</legend>
            <table id="rules" class="table table-striped table-bordered">
              <thead>
                <tr>
                  <td class="text-start required">{{ entry_rule_type }}</td>
                  <td class="text-start required">{{ entry_operator }}</td>
                  <td class="text-start required">{{ entry_value }}</td>
                  <td></td>
                </tr>
              </thead>
              <tbody>
                {% set rule_row = 0 %}
                {% for rule in rules %}
                  <tr id="rule-row{{ rule_row }}">
                    <td class="text-start">
                      <select name="rules[{{ rule_row }}][type]" class="form-select rule-type" data-row="{{ rule_row }}">
                        <option value="customer_total_orders" {% if rule.type == 'customer_total_orders' %}selected{% endif %}>Total Orders</option>
                        <option value="customer_group" {% if rule.type == 'customer_group' %}selected{% endif %}>Customer Group</option>
                        <option value="customer_total_spent" {% if rule.type == 'customer_total_spent' %}selected{% endif %}>Total Spent</option>
                        <option value="customer_country" {% if rule.type == 'customer_country' %}selected{% endif %}>Country</option>
                        <option value="customer_last_login" {% if rule.type == 'customer_last_login' %}selected{% endif %}>Date Last Login</option>
                      </select>
                    </td>
                    <td class="text-start">
                      <select name="rules[{{ rule_row }}][operator]" class="form-select">
                        <option value=">" {% if rule.operator == '>' %}selected{% endif %}>&gt;</option>
                        <option value="<" {% if rule.operator == '<' %}selected{% endif %}>&lt;</option>
                        <option value="=" {% if rule.operator == '=' %}selected{% endif %}>=</option>
                        <option value="!=" {% if rule.operator == '!=' %}selected{% endif %}>!=</option>
                      </select>
                    </td>
                    <td class="text-start rule-value-cell">
                      {% if rule.type == 'customer_group' %}
                        <select name="rules[{{ rule_row }}][value]" class="form-select">
                          {% for customer_group in customer_groups %}
                            <option value="{{ customer_group.customer_group_id }}" {% if rule.value == customer_group.customer_group_id %}selected{% endif %}>{{ customer_group.name }}</option>
                          {% endfor %}
                        </select>
                      {% elseif rule.type == 'customer_country' %}
                        <select name="rules[{{ rule_row }}][value]" class="form-select">
                          {% for country in countries %}
                            <option value="{{ country.country_id }}" {% if rule.value == country.country_id %}selected{% endif %}>{{ country.name }}</option>
                          {% endfor %}
                        </select>
                      {% else %}
                        <input type="text" name="rules[{{ rule_row }}][value]" value="{{ rule.value }}" class="form-control"/>
                      {% endif %}
                    </td>
                    <td class="text-end"><button type="button" onclick="$('#rule-row{{ rule_row }}').remove();" data-bs-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>
                  </tr>
                  {% set rule_row = rule_row + 1 %}
                {% endfor %}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3"></td>
                  <td class="text-end"><button type="button" onclick="addRule();" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i></button></td>
                </tr>
              </tfoot>
            </table>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var rule_row = {{ rule_row }};
var customer_groups = {{ customer_groups|json_encode }};
var countries = {{ countries|json_encode }};

function addRule() {
    var html = '<tr id="rule-row' + rule_row + '">';
    html += '  <td class="text-start">';
    html += '    <select name="rules[' + rule_row + '][type]" class="form-select rule-type" data-row="' + rule_row + '">';
    html += '      <option value="customer_total_orders">Total Orders</option>';
    html += '      <option value="customer_group">Customer Group</option>';
    html += '      <option value="customer_total_spent">Total Spent</option>';
    html += '      <option value="customer_country">Country</option>';
    html += '      <option value="customer_last_login">Date Last Login</option>';
    html += '    </select>';
    html += '  </td>';
    html += '  <td class="text-start">';
    html += '    <select name="rules[' + rule_row + '][operator]" class="form-select">';
    html += '      <option value=">">&gt;</option>';
    html += '      <option value="<">&lt;</option>';
    html += '      <option value="=">=</option>';
    html += '      <option value="!=">!=</option>';
    html += '    </select>';
    html += '  </td>';
    html += '  <td class="text-start rule-value-cell"><input type="text" name="rules[' + rule_row + '][value]" value="" class="form-control" placeholder="YYYY-MM-DD for dates"/></td>';
    html += '  <td class="text-end"><button type="button" onclick="$(\'#rule-row' + rule_row + '\').remove();" data-bs-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button></td>';
    html += '</tr>';

    $('#rules tbody').append(html);

    rule_row++;
}

$(document).on('change', '.rule-type', function() {
    var row = $(this).data('row');
    var type = $(this).val();
    var valueCell = $('#rule-row' + row + ' .rule-value-cell');
    var html = '';

    switch(type) {
        case 'customer_group':
            html += '<select name="rules[' + row + '][value]" class="form-select">';
            for (var i = 0; i < customer_groups.length; i++) {
                html += '<option value="' + customer_groups[i]['customer_group_id'] + '">' + customer_groups[i]['name'] + '</option>';
            }
            html += '</select>';
            break;
        case 'customer_country':
            html += '<select name="rules[' + row + '][value]" class="form-select">';
            for (var i = 0; i < countries.length; i++) {
                html += '<option value="' + countries[i]['country_id'] + '">' + countries[i]['name'] + '</option>';
            }
            html += '</select>';
            break;

        case 'customer_total_orders':
        case 'customer_total_spent':
        case 'customer_last_login':
        default:
            html += '<input type="text" name="rules[' + row + '][value]" value="" class="form-control" placeholder="YYYY-MM-DD for dates"/>';
            break;
    }

    valueCell.html(html);
});
//--></script>
{{ footer }}