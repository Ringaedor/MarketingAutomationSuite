{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-mas" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-mas" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_mas_status" value="0"/>
                <input type="checkbox" name="module_mas_status" value="1" id="input-status" class="form-check-input" {% if module_mas_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>

        <hr>

        <div class="row" id="mas-module-cards">
            {# Module cards will be added here by the menu event controller or this view directly as they are developed #}
            <div class="col-md-12">
                <p>Welcome to the Marketing Automation Suite. Modules will appear here as they are developed and enabled.</p>
            </div>
        </div>

      </div>
    </div>
  </div>
</div>
{{ footer }}