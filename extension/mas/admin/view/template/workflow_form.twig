{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" id="button-save" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_workflow_form }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-workflow" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="workflow_id" value="{{ workflow_id }}"/>
          <input type="hidden" name="workflow_data" id="input-workflow-data" value=""/>

          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="status" value="0"/>
                    <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input" {% if status %} checked {% endif %}/>
                </div>
            </div>
          </div>
        </form>

        <fieldset>
            <legend>Workflow Editor</legend>

            <div class="card bg-light mb-3">
              <div class="card-header"><strong>{{ text_trigger_step }}</strong></div>
              <div class="card-body">
                <h5 class="card-title">{{ text_trigger_heading }}</h5>
                <p class="card-text">{{ text_trigger_help }}</p>
                <div class="row">
                    <label for="input-trigger" class="col-sm-2 col-form-label">Trigger Event</label>
                    <div class="col-sm-10">
                        <select id="input-trigger" class="form-select">
                            <option value="customer_register" {% if workflow_data.trigger == 'customer_register' %}selected{% endif %}>Customer Registers</option>
                            <option value="order_complete" {% if workflow_data.trigger == 'order_complete' %}selected{% endif %}>Order is Completed</option>
                        </select>
                    </div>
                </div>
              </div>
            </div>

            <div class="card-header mt-3"><strong>Step 2: Nodes (Conditions & Actions)</strong></div>
            <div id="workflow-nodes" class="list-group mt-3">
                {# Nodes will be rendered here by JavaScript #}
            </div>
            <div class="mt-3">
                <button type="button" id="button-add-condition" class="btn btn-outline-primary"><i class="fa-solid fa-plus"></i> Add Condition</button>
                <button type="button" id="button-add-email-action" class="btn btn-outline-secondary"><i class="fa-solid fa-paper-plane"></i> Add Email Action</button>
                <button type="button" id="button-add-ai-email-action" class="btn btn-outline-info"><i class="fa-solid fa-robot"></i> Add AI Email Action</button>
            </div>
        </fieldset>

      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
// Data passed from the controller
var segments = {{ segments|json_encode|html_entity_decode('ENT_QUOTES') }};
var providers = {{ providers|json_encode|html_entity_decode('ENT_QUOTES') }};
var templates = {{ templates|json_encode|html_entity_decode('ENT_QUOTES') }};
var workflow_data = {{ workflow_data|json_encode|html_entity_decode('ENT_QUOTES') }};
var existing_nodes = workflow_data.nodes ? workflow_data.nodes : [];
var node_row = 0;

// Function to add a new node to the editor
function addNode(type, data = {}) {
    var html = '<div class="list-group-item mb-3" id="node-row' + node_row + '">';
    html += '  <div class="d-flex w-100 justify-content-between">';

    // Node specific content
    if (type === 'condition') {
        html += '    <h5 class="mb-1">Condition: Check Segment</h5>';
        html += '  </div>';
        html += '  <input type="hidden" class="node-type" value="condition">';
        html += '  <p class="mb-1">Check if customer belongs to segment:</p>';
        html += '  <select class="form-select node-segment-id">';
        for (var i = 0; i < segments.length; i++) {
            var selected = (data.segment_id == segments[i].segment_id) ? ' selected' : '';
            html += '<option value="' + segments[i].segment_id + '"' + selected + '>' + segments[i].name + '</option>';
        }
        html += '  </select>';
    } else if (type === 'action_email') {
        html += '    <h5 class="mb-1">Action: Send Email</h5>';
        html += '  </div>';
        html += '  <input type="hidden" class="node-type" value="action">';
        html += '  <input type="hidden" class="node-action-type" value="send_email">';
        html += '  <p class="mb-1">Send an email using provider:</p>';
        html += '  <select class="form-select node-provider mb-2">';
        for (var i = 0; i < providers.length; i++) {
             if (providers[i].type === 'smtp') {
                var selected = (data.provider == providers[i].name) ? ' selected' : '';
                html += '<option value="' + providers[i].name + '"' + selected + '>' + providers[i].name + ' (' + providers[i].type + ')</option>';
             }
        }
        html += '  </select>';
        html += '  <p class="mb-1 mt-2">with template:</p>';
        html += '  <select class="form-select node-template-id">';
        for (var i = 0; i < templates.length; i++) {
             var selected = (data.template_id == templates[i].template_id) ? ' selected' : '';
            html += '<option value="' + templates[i].template_id + '"' + selected + '>' + templates[i].name + '</option>';
        }
        html += '  </select>';
    } else if (type === 'action_ai_email') {
        html += '    <h5 class="mb-1">Action: Send AI-Generated Email</h5>';
        html += '  </div>';
        html += '  <input type="hidden" class="node-type" value="action">';
        html += '  <input type="hidden" class="node-action-type" value="send_ai_email">';
        html += '  <p class="mb-1">Generate email content using AI provider:</p>';
        html += '  <select class="form-select node-ai-provider mb-2">';
        for (var i = 0; i < providers.length; i++) {
            if (providers[i].type === 'anthropic') {
                var selected = (data.ai_provider == providers[i].name) ? ' selected' : '';
                html += '<option value="' + providers[i].name + '"' + selected + '>' + providers[i].name + '</option>';
            }
        }
        html += '  </select>';
        html += '  <p class="mb-1 mt-2">with the prompt:</p>';
        html += '  <textarea class="form-control node-prompt mb-2" placeholder="e.g. Write a friendly welcome email for {firstname}">' + (data.prompt || '') + '</textarea>';
        html += '  <p class="mb-1 mt-2">and send it using SMTP provider:</p>';
        html += '  <select class="form-select node-smtp-provider">';
        for (var i = 0; i < providers.length; i++) {
             if (providers[i].type === 'smtp') {
                var selected = (data.smtp_provider == providers[i].name) ? ' selected' : '';
                html += '<option value="' + providers[i].name + '"' + selected + '>' + providers[i].name + '</option>';
             }
        }
        html += '  </select>';
        html += '  <p class="mb-1 mt-2">with the subject line:</p>';
        html += '  <input type="text" class="form-control node-subject" value="' + (data.subject || '') + '" placeholder="e.g. A special welcome for {firstname}!"/>';
    }

    html += '<button type="button" onclick="$(\'#node-row' + node_row + '\').remove();" class="btn btn-sm btn-danger mt-2 float-end"><i class="fa-solid fa-trash"></i> Remove</button>';
    html += '</div>';

    $('#workflow-nodes').append(html);
    node_row++;
}

// Function to serialize the workflow from the DOM into the hidden input
function serializeWorkflow() {
    var workflow = {
        'trigger': $('#input-trigger').val(),
        'nodes': []
    };

    $('#workflow-nodes .list-group-item').each(function(index, element) {
        var node = {};
        node.type = $(element).find('.node-type').val();

        if (node.type === 'condition') {
            node.condition_type = $(element).find('.node-condition-type').val();
            node.segment_id = $(element).find('.node-segment-id').val();
        } else if (node.type === 'action') {
            node.action_type = $(element).find('.node-action-type').val();
            if (node.action_type === 'send_email') {
                node.provider = $(element).find('.node-provider').val();
                node.template_id = $(element).find('.node-template-id').val();
            } else if (node.action_type === 'send_ai_email') {
                node.ai_provider = $(element).find('.node-ai-provider').val();
                node.prompt = $(element).find('.node-prompt').val();
                node.subject = $(element).find('.node-subject').val();
                node.smtp_provider = $(element).find('.node-smtp-provider').val();
            }
        }
        workflow.nodes.push(node);
    });

    $('#input-workflow-data').val(JSON.stringify(workflow));
}

// Event listeners for buttons
$('#button-add-condition').on('click', function() {
    addNode('condition');
});

$('#button-add-email-action').on('click', function() {
    addNode('action_email');
});

$('#button-add-ai-email-action').on('click', function() {
    addNode('action_ai_email');
});


$('#button-save').on('click', function() {
    serializeWorkflow();
    $('#form-workflow').submit();
});

// Render existing nodes on page load
$(document).ready(function() {
    if(existing_nodes) {
        for(var i = 0; i < existing_nodes.length; i++) {
            var node = existing_nodes[i];
            var nodeType = node.type;
            if (nodeType === 'action') {
                if (node.action_type === 'send_email') {
                    nodeType = 'action_email';
                } else if (node.action_type === 'send_ai_email') {
                    nodeType = 'action_ai_email';
                }
            }
            addNode(nodeType, node);
        }
    }
});

//--></script>
{{ footer }}