{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_dashboard_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-chart-line"></i> {{ text_dashboard_overview }}</div>
      <div class="card-body">
        <div class="row">
          <div class="col-lg-12 text-center">
            <p>{{ text_welcome_dashboard }}</p>
            <!-- Dashboard widgets and KPIs -->
            <div class="row">
              <div class="col-lg-3 col-md-6">
                <div class="card text-white bg-primary mb-3">
                  <div class="card-header"><i class="fa-solid fa-users"></i> Total Customers</div>
                  <div class="card-body">
                    <h5 class="card-title display-4">{{ total_customers }}</h5>
                    <a href="{{ customer_link }}" class="card-link text-white stretched-link">View Customers</a>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card text-white bg-info mb-3">
                  <div class="card-header"><i class="fa-solid fa-chart-pie"></i> Total Segments</div>
                  <div class="card-body">
                    <h5 class="card-title display-4">{{ total_segments }}</h5>
                    <a href="{{ segment_link }}" class="card-link text-white stretched-link">View Segments</a>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card text-white bg-success mb-3">
                  <div class="card-header"><i class="fa-solid fa-check-circle"></i> Active Providers</div>
                  <div class="card-body">
                    <h5 class="card-title display-4">{{ active_providers }}</h5>
                    <a href="{{ provider_link }}" class="card-link text-white stretched-link">Manage</a>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card text-white bg-secondary mb-3">
                  <div class="card-header"><i class="fa-solid fa-cogs"></i> Total Providers</div>
                  <div class="card-body">
                    <h5 class="card-title display-4">{{ total_providers }}</h5>
                     <a href="{{ provider_link }}" class="card-link text-white stretched-link">Configure</a>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card text-white bg-warning mb-3">
                  <div class="card-header"><i class="fa-solid fa-bullhorn"></i> Active Campaigns</div>
                  <div class="card-body">
                    <h5 class="card-title display-4">{{ active_campaigns }}</h5>
                     <a href="{{ campaign_link }}" class="card-link text-white stretched-link">Manage Campaigns</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}